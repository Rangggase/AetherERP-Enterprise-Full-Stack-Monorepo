# SQLite (default, zero setup). Open backend/data/aether_erp.db in DBeaver.
DATABASE_URL=sqlite:///./data/aether_erp.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://aether:secret@localhost:5432/aether_erp

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
PO_APPROVAL_THRESHOLD=50000000
